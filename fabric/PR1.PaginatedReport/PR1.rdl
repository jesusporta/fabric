  <DataSources>
    <DataSource Name="SM1_LK1">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-eb6d9e91-2f67-4da2-9f06-d5c326fd73b9;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
