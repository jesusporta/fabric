    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>SM1_LK1</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP(
				'customers'[FirstName],
				'customers'[LastName],
				'customers'[Email],
				'customers'[City],
				'customers'[CreatedDate]
			), "IsGrandTotalRowTotal"
		),
		"CountCustomerID", CALCULATE(COUNTA('customers'[CustomerID])),
		"SumAge", CALCULATE(SUM('customers'[Age]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'customers'[FirstName],
	'customers'[LastName],
	'customers'[Email],
	'customers'[City],
	'customers'[CreatedDate]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP(
					'customers'[FirstName],
					'customers'[LastName],
					'customers'[Email],
					'customers'[City],
					'customers'[CreatedDate]
				), "IsGrandTotalRowTotal"
			),
			"CountCustomerID", CALCULATE(COUNTA('customers'[CustomerID])),
			"SumAge", CALCULATE(SUM('customers'[Age]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'customers'[FirstName],
			1,
			'customers'[LastName],
			1,
			'customers'[Email],
			1,
			'customers'[City],
			1,
			'customers'[CreatedDate],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'customers'[FirstName],
	'customers'[LastName],
	'customers'[Email],
	'customers'[City],
	'customers'[CreatedDate]</wa:PreviewCommandText>
      </Query>
      <Fields>
        <Field Name="customers_CustomerID">
          <DataField>[CountCustomerID]</DataField>
        </Field>
        <Field Name="customers_FirstName">
          <DataField>customers[FirstName]</DataField>
          <AggregateIndicatorField xmlns="http://schemas.microsoft.com/sqlserver/reporting/2011/01/reportdefinition">x_5b_IsGrandTotalRowTotal_5d_</AggregateIndicatorField>
        </Field>
        <Field Name="customers_LastName">
